# ── Dev environment ───────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for local development.
# Never commit .env — it is gitignored.

# ── Encryption ────────────────────────────────────────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_SECRET=REPLACE

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (simplest for local dev)
DATABASE_URL=

# ── Session ───────────────────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE

# ── Auth0 ─────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=REPLACE
AUTH0_CLIENT_SECRET=REPLACE
AUTH0_CALLBACK_URL=http://localhost:8000/auth/callback

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Path prefix (leave empty for local dev — no reverse proxy) ────────────────
ROOT_PATH=

# ── Optional tuning ───────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# MAX_FILE_SIZE_MB=10
# MAX_PDF_PAGES=50
# UPLOAD_DIR=uploads
