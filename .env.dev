# ── Dev environment ───────────────────────────────────────────────────────────
# Loaded automatically when APP_ENV=dev (set in your root .env file).
# Safe to commit — no real secrets. Fill in REPLACE values locally.

APP_ENV=dev

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate once per developer:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_SECRET=4BrLNFn72fBPAzMV5jzwJDdbmRnq7Cfk0hTu6SWPUm0=

# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres via scripts/local-db.sh (password matches DB_PASSWORD default)
# Change DB_PASSWORD here and in .env if you used a custom password
DATABASE_URL=postgresql://pragna:localdevpassword@localhost:5432/pragna
DB_PASSWORD=localdevpassword
DB_POOL_SIZE=5

# ── Session ───────────────────────────────────────────────────────────────────
# Generate once per developer:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=fea7172d9909bd9baf6467d87005fad43c4d027ab9d6ee6373db3ef06cd0eadb

# ── Auth0 ─────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=REPLACE
AUTH0_CLIENT_ID=REPLACE
AUTH0_CLIENT_SECRET=REPLACE
AUTH0_CALLBACK_URL=http://localhost:8000/auth/callback

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Path prefix ───────────────────────────────────────────────────────────────
# Empty for local dev — no reverse proxy
ROOT_PATH=

# ── Pipeline limits ───────────────────────────────────────────────────────────
MAX_REVISIONS=5
MAX_DISCOVERY_QUESTIONS=30

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=50

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
